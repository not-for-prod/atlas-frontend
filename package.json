{
  "name": "atlas-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.8",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "bun lint:ts && bun typecheck && bun lint:css && bun format:check",
    "lint:ts": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "skills:validate": "python3 scripts/validate-skills.py",
    "codegen": "orval --config orval.config.ts",
    "test:e2e": "playwright test",
    "test:production": "TEST_PRODUCTION=1 playwright test"
  },
  "dependencies": {
    "@mantine/core": "9.4.1",
    "@mantine/form": "9.4.1",
    "@mantine/hooks": "9.4.1",
    "@mantine/modals": "9.4.1",
    "@mantine/notifications": "9.4.1",
    "@tabler/icons-react": "3.44.0",
    "@tanstack/react-query": "5.101.2",
    "decimal.js": "10.6.0",
    "ky": "2.0.2",
    "next": "16.2.10",
    "qrcode.react": "4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-intl": "10.1.14"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@vitejs/plugin-react": "6.0.3",
    "ajv": "8.17.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "jsqr": "1.4.0",
    "orval": "8.20.0",
    "postcss": "8.5.16",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.4",
    "stylelint": "17.14.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
